[Unit]
Description=Ambient-light adaptive display brightness (webcam light meter)
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/ambient-brightness

# Restart on crash, but don't hot-loop if something is fundamentally broken
# (e.g. brightnessctl missing, camera permanently unavailable).
Restart=on-failure
RestartSec=5s

# Background convenience daemon: stay out of the way of interactive work, and
# let the kernel batch its 10 s wakeups with other timers.
Nice=10
IOSchedulingClass=idle
TimerSlackNSec=1s

# Needs /dev/video0 (video group) and brightnessctl (which goes through logind).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=default.target
