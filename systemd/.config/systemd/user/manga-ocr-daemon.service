[Unit]
Description=manga-ocr daemon for in-game Japanese OCR
Requires=manga-ocr-daemon.socket

[Service]
# Started on demand by manga-ocr-daemon.socket; exits by itself after 30 idle
# minutes. Uses the venv's python since manga-ocr pulls in torch.
ExecStart=%h/.local/share/manga-ocr-venv/bin/python3 %h/.local/bin/manga-ocr-daemon
Restart=on-failure
RestartSec=2
Nice=5
